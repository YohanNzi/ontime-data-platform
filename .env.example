# Copier en .env (gitignoré) puis remplir. Ne jamais committer .env.
# UID de l'utilisateur hôte : `id -u`
AIRFLOW_UID=502
# Clé de chiffrement des Connections/Variables : openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=
# Secret de signature des jetons de l'API d'exécution : openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=
