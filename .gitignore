# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data (CSV/Parquet volumineux, jamais commités)
data/

# Ruff / pytest
.ruff_cache/
.pytest_cache/
.coverage

# dbt (artefacts générés, jamais commités)
dbt/*/target/
dbt/*/logs/
dbt/*/dbt_packages/
dbt/*/.user.yml


# Airflow (secrets, logs et config générés localement)
.env
logs/
config/

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate*
infra/terraform/tfplan
